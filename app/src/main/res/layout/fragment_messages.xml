<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Mesaj Oluşturma / Planlama Kartı -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yeni Mesaj Planla"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="12dp" />

                <!-- Alıcı Seç Butonu & Özeti -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectRecipients"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Kişi / Grup Seç"
                    app:icon="@android:drawable/ic_menu_myplaces"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/btn_msg_bg"
                    android:textColor="@color/btn_msg_text"
                    app:iconTint="@color/btn_msg_text" />

                <TextView
                    android:id="@+id/tvSelectedRecipientsSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alıcı seçilmedi."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Kanal Seçimi (SMS veya WhatsApp) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gönderim Kanalı:"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <RadioGroup
                    android:id="@+id/rgChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbSms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="📱 Normal SMS"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbWhatsApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💬 WhatsApp"
                        android:textSize="14sp" />
                </RadioGroup>

                <!-- Şablon Seç Butonu -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectTemplate"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Hazır Şablon Ekle (Günaydın, Bayram vb.)"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Mesaj Metni -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mesaj Metni (Değişkenler: {AD}, {TARIH}, {SAAT})"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMessageBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="3"
                        android:gravity="top|start"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tarih ve Saat Seçimi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectDate"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Tarih Seç"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/btn_time_bg"
                        android:textColor="@color/btn_time_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectTime"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Saat Seç"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/btn_time_bg"
                        android:textColor="@color/btn_time_text" />
                </LinearLayout>

                <!-- Gönderim Öncesi Onay Switch (Kullanıcı İsteği: Bana sormadan gönder, mesaj gitti bildirimi al) -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchRequireConfirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Gönderim öncesi bana sor (Kapalı: Otomatik gönderir, 'Mesaj Gitti' bildirimi verir)"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="16dp" />

                <!-- ONAY & PLANLA BUTONU (BÜYÜK) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlanOrSend"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="MESAJI PLANLA / GÖNDER"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/on_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Planlanan ve Geçmiş Mesajlar Başlığı & Filtreleme Sekmeleri -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Planlanan &amp; Bekleyen Mesajlar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMessageFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tümü"
                    android:checked="true"
                    app:chipBackgroundColor="@color/btn_msg_bg"
                    app:chipStrokeColor="@color/card_border" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterPendingApproval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳ Onay Bekleyenler"
                    app:chipBackgroundColor="@color/btn_time_bg"
                    app:chipStrokeColor="@color/card_border" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterScheduled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ Planlananlar"
                    app:chipBackgroundColor="@color/btn_bday_bg"
                    app:chipStrokeColor="@color/card_border" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterSuccess"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ İletilenler"
                    app:chipBackgroundColor="@color/btn_msg_bg"
                    app:chipStrokeColor="@color/card_border" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScheduledMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvEmptyMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Planlanmış mesaj bulunmuyor."
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
